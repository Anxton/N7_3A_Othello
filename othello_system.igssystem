        "scripts": [
            {
                "code": "//\n// vv\n//\n// created on 2026-01-31\n//\n\n// The script language documentation is available at\n// https://ingescape.com/verification-validation-using-ingescape/\n\n\"Reset game Test\" {\n    OthelloAgent.resetGame()\n\n    assert OthelloAgent.board == \"[[null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null], [null, null, null, \\\"Blancs\\\", \\\"Noirs\\\", null, null, null], [null, null, null, \\\"Noirs\\\", \\\"Blancs\\\", null, null, null], [null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null]]\"\n    assert OthelloAgent.possibleMoves == \"[[2, 4], [3, 5], [4, 2], [5, 3]]\"\n    assert OthelloAgent.scores == \"[2, 2]\"\n    assert OthelloAgent.getTurn == \"\\\"Blancs\\\"\"\n    assert OthelloAgent.isGameOver == 0\n}\n\n\n\"Click to play Test\" {\n    OthelloAgent.resetGame()\n    OthelloAgent.click = \"{\\\"x\\\":368,\\\"y\\\":291}\"\n\n    // this test doesn't work for some reason\n    assert OthelloAgent.board == \"[[null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null], [null, null, null, null, \\\"Blancs\\\", null, null, null], [null, null, null, \\\"Blancs\\\", \\\"Blancs\\\", null, null, null], [null, null, null, \\\"Noirs\\\", \\\"Blancs\\\", null, null, null], [null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null], [null, null, null, null, null, null, null, null]]\"\n    assert OthelloAgent.possibleMoves == \"[[2, 3], [2, 5], [4, 5]]\"\n    assert OthelloAgent.scores == \"[4, 1]\"\n    assert OthelloAgent.getTurn == \"\\\"Noirs\\\"\"\n    assert OthelloAgent.isGameOver == 0\n}\n\n",
                "name": "vv",
                "package": "",
                "uuid": "e7e2aedf-c31f-410e-991b-8324a9350bba"
            }
        ]
    },
